---
import { platforms, rssFeed } from '../lib/platforms';

const links = [...platforms, rssFeed];
// 로고 옆 사운드웨이브 막대 높이(px)
const waveBars = [8, 16, 11, 20, 9];
---

<header class="sticky top-0 z-50 bg-midnight/85 backdrop-blur border-b border-line-soft">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-2.5 flex items-center justify-between gap-4">
    <a
      href="/"
      class="flex items-center gap-3 rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon focus-visible:ring-offset-2 focus-visible:ring-offset-midnight"
    >
      <img src="/favicon.svg" alt="" width="40" height="40" class="size-9 sm:size-10 rounded-[10px]" />
      <span class="text-xl sm:text-[22px] font-black tracking-tight">달레줄레</span>
      <span class="hidden sm:flex items-center gap-[3px] h-5" aria-hidden="true">
        {waveBars.map((height) => <span class="w-[3px] rounded-sm bg-neon" style={`height: ${height}px`} />)}
      </span>
    </a>
    <nav aria-label="플랫폼 링크" class="flex items-center">
      {links.map(({ name, url, icon }) => (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={name}
          class="size-11 flex items-center justify-center rounded-xl text-mist hover:text-neon-soft hover:bg-panel transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon"
        >
          <span class="size-5 [&>svg]:size-full" aria-hidden="true" set:html={icon} />
        </a>
      ))}
    </nav>
  </div>
</header>
