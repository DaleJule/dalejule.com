---
import { Image } from 'astro:assets';
import type { Episode } from '../lib/types';
import { formatDate } from '../lib/format';
import CoverFallback from './CoverFallback.astro';

interface Props {
  episode: Episode;
}

const { episode } = Astro.props;
const formattedDate = formatDate(episode.publishDate);
---

<li class="group relative flex flex-col rounded-[20px] bg-panel border border-line-soft overflow-hidden hover:border-line transition-colors focus-within:ring-2 focus-within:ring-neon">
  {episode.imageUrl ? (
    <Image
      src={episode.imageUrl}
      alt=""
      width={640}
      height={640}
      format="webp"
      class="block w-full aspect-square object-cover bg-raised"
    />
  ) : (
    <CoverFallback episodeNumber={episode.episodeNumber} />
  )}

  <div class="flex-1 flex flex-col gap-2.5 px-5.5 pt-5 pb-5.5">
    <!-- text-dim on panel = 5.67:1 (WCAG AA) -->
    <div class="flex flex-wrap gap-2 font-mono text-xs text-dim whitespace-nowrap">
      <span class="text-neon-soft font-bold">EP.{episode.episodeNumber}</span>
      {formattedDate && <span aria-hidden="true">·</span>}
      {formattedDate && <span>{formattedDate}</span>}
      {episode.duration && <span aria-hidden="true">·</span>}
      {episode.duration && <span>{episode.duration}</span>}
    </div>
    <h3 class="text-[19px] leading-snug font-extrabold tracking-tight">
      <!-- after:inset-0 으로 카드 전체를 클릭 영역으로 만든다 -->
      <a
        href={`/episodes/${episode.episodeNumber}`}
        class="group-hover:text-neon-soft transition-colors focus-visible:outline-none after:absolute after:inset-0"
      >
        {episode.title}
      </a>
    </h3>
    {episode.description && (
      <p class="text-[15px] leading-relaxed text-mist line-clamp-2">{episode.description}</p>
    )}
  </div>
</li>
