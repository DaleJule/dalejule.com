---
import { Image, getImage } from 'astro:assets';
import { getPodcastData } from '../../lib/rss';
import { formatDate } from '../../lib/format';
import { platforms } from '../../lib/platforms';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CoverFallback from '../../components/CoverFallback.astro';
import EpisodePlayer from '../../components/EpisodePlayer.astro';
import EpisodeChapters from '../../components/EpisodeChapters.astro';
import EpisodeNav from '../../components/EpisodeNav.astro';
import Giscus from '../../components/Giscus.astro';
import type { Episode } from '../../lib/types';
export async function getStaticPaths() {
  const { episodes } = await getPodcastData();
  // 피드는 최신순이라 목록의 다음 항목이 이전 에피소드다
  return episodes.map((episode, index) => ({
    params: { episodeNumber: String(episode.episodeNumber) },
    props: { episode, previous: episodes[index + 1], next: episodes[index - 1] },
  }));
}

interface Props {
  episode: Episode;
  previous?: Episode;
  next?: Episode;
}

const { episode, previous, next } = Astro.props;

const siteUrl = 'https://dalejule.com';
const canonicalUrl = `${siteUrl}/episodes/${episode.episodeNumber}`;
const episodeTitle = `EP.${episode.episodeNumber} ${episode.title}`;
const pageTitle = `${episodeTitle} — 달레줄레 팟캐스트`;
const pageDescription = episode.description.slice(0, 160);

const descriptionHtml = episode.descriptionHtml ?? '';

// 에피소드 아트를 공유 썸네일로 쓴다. 원본은 최대 2MB라 빌드 시 자체 호스팅 사본을 만든다
const ogImage = episode.imageUrl
  ? await getImage({ src: episode.imageUrl, width: 1200, height: 1200, format: 'jpg' })
  : undefined;

const formattedDate = formatDate(episode.publishDate);
---

<Layout
  title={pageTitle}
  ogTitle={episodeTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  imageUrl={ogImage?.src}
  twitterCard={ogImage ? 'summary' : undefined}
>
  <Header />
  <main id="main-content">
    <section aria-labelledby="episode-title" class="relative overflow-hidden border-b border-line-soft">
      {episode.imageUrl && (
        <!-- 커버를 흐리게 깔아 에피소드마다 다른 분위기를 낸다. 아래 커버와 같은 변환이라 추가 다운로드가 없다 -->
        <Image
          src={episode.imageUrl}
          alt=""
          width={640}
          height={640}
          format="webp"
          aria-hidden="true"
          class="absolute -inset-20 w-[calc(100%+10rem)] h-[calc(100%+10rem)] max-w-none object-cover blur-[70px] saturate-[1.3] opacity-35"
        />
      )}
      <!-- 모든 커버 아래쪽에 오렌지 로고 띠가 있어서, 세로로 긴 모바일 헤더에서는 그 띠가 비친다. 아래로 갈수록 덮는다 -->
      <div class="absolute inset-0 bg-linear-to-b from-midnight/40 via-midnight/60 to-midnight" aria-hidden="true"></div>

      <div class="relative max-w-6xl mx-auto px-4 sm:px-6 pt-8 pb-12 sm:pb-14">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 min-h-11 mb-6 sm:mb-10 text-[15px] font-bold text-mist hover:text-neon-soft transition-colors"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
          모든 에피소드
        </a>

        <div class="flex flex-wrap items-end gap-8 sm:gap-12">
          <div class="w-48 sm:w-80 max-w-full shrink-0 rounded-3xl border border-line overflow-hidden shadow-[0_0_60px_rgba(255,122,26,0.3),0_30px_80px_rgba(0,0,0,0.6)]">
            {episode.imageUrl ? (
              <!-- fetchpriority="high": above-fold critical image -->
              <Image
                src={episode.imageUrl}
                alt=""
                width={640}
                height={640}
                format="webp"
                loading="eager"
                fetchpriority="high"
                class="block w-full aspect-square object-cover"
              />
            ) : (
              <CoverFallback episodeNumber={episode.episodeNumber} />
            )}
          </div>

          <div class="flex-[1_1_480px] min-w-0 flex flex-col gap-5">
            <p class="font-mono text-[15px] font-bold tracking-wide text-neon-soft">EP.{episode.episodeNumber}</p>
            <h1 id="episode-title" class="text-3xl sm:text-[46px] leading-tight font-black tracking-tight">
              {episode.title}
            </h1>
            <div class="flex flex-wrap gap-2.5 font-mono text-sm text-mist">
              {formattedDate && <span>{formattedDate}</span>}
              {episode.duration && formattedDate && <span class="text-line" aria-hidden="true">/</span>}
              {episode.duration && <span>{episode.duration}</span>}
            </div>
            <div class="flex flex-wrap gap-2.5 mt-1">
              {platforms.map(({ shortName, url, icon }) => (
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 h-11 px-4.5 rounded-full bg-panel/80 border border-line text-[15px] font-bold hover:border-neon-soft hover:text-neon-soft transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon"
                >
                  <span class="size-4 [&>svg]:size-full" aria-hidden="true" set:html={icon} />
                  {shortName}
                </a>
              ))}
            </div>
          </div>
        </div>

        {episode.audioUrl && (
          <div class="mt-10 sm:mt-12">
            <EpisodePlayer episode={episode} />
          </div>
        )}
      </div>
    </section>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-14 sm:py-16">
      <div class="flex flex-wrap items-start gap-12 lg:gap-14">
        {descriptionHtml && (
          <article aria-labelledby="notes-title" class="flex-[999_1_560px] min-w-0 max-w-3xl">
            <p class="mb-2 font-mono text-[13px] tracking-wider text-neon-soft" aria-hidden="true">// SHOW NOTES</p>
            <h2 id="notes-title" class="mb-7 text-[28px] font-black tracking-tight">쇼노트</h2>
            <div class="prose max-w-none" set:html={descriptionHtml} />
          </article>
        )}
        {episode.audioUrl && episode.chapters.length > 0 && (
          <div class="flex-[1_1_340px] min-w-0">
            <EpisodeChapters chapters={episode.chapters} />
          </div>
        )}
      </div>

      <EpisodeNav previous={previous} next={next} />

      <Giscus />
    </div>
  </main>
  <Footer />
</Layout>
