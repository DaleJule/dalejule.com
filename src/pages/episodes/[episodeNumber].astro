---
import { Image, getImage } from 'astro:assets';
import { getPodcastData } from '../../lib/rss';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Giscus from '../../components/Giscus.astro';
import type { Episode } from '../../lib/types';
export async function getStaticPaths() {
  const { meta, episodes } = await getPodcastData();
  return episodes.map((episode) => ({
    params: { episodeNumber: String(episode.episodeNumber) },
    props: { episode },
  }));
}

interface Props {
  episode: Episode;
}

const { episode } = Astro.props;

const siteUrl = 'https://dalejule.com';
const canonicalUrl = `${siteUrl}/episodes/${episode.episodeNumber}`;
const episodeTitle = `EP.${episode.episodeNumber} ${episode.title}`;
const pageTitle = `${episodeTitle} — 달레줄레 팟캐스트`;
const pageDescription = episode.description.slice(0, 160);

const descriptionHtml = episode.descriptionHtml ?? '';

// 에피소드 아트를 공유 썸네일로 쓴다. 원본은 최대 2MB라 빌드 시 자체 호스팅 사본을 만든다
const ogImage = episode.imageUrl
  ? await getImage({ src: episode.imageUrl, width: 1200, height: 1200, format: 'jpg' })
  : undefined;

const platforms = [
  { name: 'Apple', url: 'https://dales.link/applepodcast', icon: '/icons/apple-podcasts.svg' },
  { name: 'Spotify', url: 'https://open.spotify.com/show/0b6RO7JD2DgGxVGRHN701H', icon: '/icons/spotify.svg' },
  { name: 'YouTube', url: 'https://www.youtube.com/playlist?list=PLapoeRAdKitf4M7HOGIDzwNtsfo6ZqO8W', icon: '/icons/youtube.svg' },
  { name: '팟빵', url: 'https://www.podbbang.com/channels/1784466/', icon: '/icons/podbbang.svg' },
].filter(({ url }) => url);

const formattedDate = episode.publishDate
  ? new Date(episode.publishDate).toLocaleDateString('ko-KR', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : '';
---

<Layout
  title={pageTitle}
  ogTitle={episodeTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  imageUrl={ogImage?.src}
  twitterCard={ogImage ? 'summary' : undefined}
>
  <Header />
  <main id="main-content" class="max-w-2xl mx-auto px-4 py-10">
    <!-- 뒤로가기 -->
    <a
      href="/"
      class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-[#FF6600] transition-colors mb-8"
    >
      ← 모든 에피소드
    </a>

    <!-- 에피소드 헤더 -->
    <div class="flex items-start gap-4 mb-6">
      {episode.imageUrl && (
        <!-- fetchpriority="high": above-fold critical image -->
        <Image
          src={episode.imageUrl}
          alt=""
          width={224}
          height={224}
          format="webp"
          loading="eager"
          fetchpriority="high"
          class="flex-shrink-0 w-20 h-20 sm:w-28 sm:h-28 rounded-xl object-cover bg-gray-100"
        />
      )}
      <div class="flex-1 min-w-0">
        <p class="text-sm font-black text-[#FF6600] mb-1">EP.{episode.episodeNumber}</p>
        <h1 class="text-2xl font-extrabold text-gray-900 leading-tight mb-2">
          {episode.title}
        </h1>
        <div class="flex items-center gap-2 text-sm text-gray-500">
          {formattedDate && <span>{formattedDate}</span>}
          {episode.duration && formattedDate && <span aria-hidden="true">·</span>}
          {episode.duration && <span>{episode.duration}</span>}
        </div>
      </div>
    </div>

    <!-- 플랫폼 듣기 버튼 -->
    <div class="flex flex-wrap gap-2 mb-8">
      {platforms.map(({ name, url, icon }) => (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 border border-gray-200 text-gray-600 text-sm font-semibold rounded-full hover:border-[#FF6600] hover:text-[#FF6600] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF6600] focus-visible:ring-offset-2"
        >
          <img src={icon} alt="" width="16" height="16" class="w-4 h-4" />
          {name}
        </a>
      ))}
    </div>

    <!-- 에피소드 설명 -->
    {descriptionHtml && (
      <div class="prose max-w-none" set:html={descriptionHtml} />
    )}

    <Giscus />
  </main>
</Layout>
